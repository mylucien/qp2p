<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- VpnService 需要前台服务权限，否则 Android 8+ 会把服务掐掉 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 起，声明了 foregroundServiceType 就必须有对应的权限，
         少了它 startForeground 会抛 SecurityException，表现为点了连接就闪退 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启：系统启动完成后按「自动连接」开关拉起隧道。
         Android 没有单独的"自启动权限"，就是这条普通权限 + 一个接收器；
         真正拦人的是厂商 ROM 的「自启动管理」，那个只能用户手动放行。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电视盒子没有触摸屏，桌面也不是 LAUNCHER：两个都声明成「非必需」，
         否则部分 TV 桌面会直接把 App 过滤掉，不显示图标 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="qp2p"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android TV / 电视盒子的桌面只认 LEANBACK_LAUNCHER，
                 少了这一条侧载后桌面上看不到图标，只能用 adb 启动 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".Qp2pVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- Android 14 起前台服务必须声明类型，VPN 归到 specialUse 并说明用途 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="p2p vpn tunnel: keep the virtual interface and peer connections alive" />
        </service>

        <!-- 开机自启。BOOT_COMPLETED 是受保护广播，只有系统能发；
             额外接一个厂商的 QUICKBOOT_POWERON，老盒子/老电视常见。 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
